{
  "name": "3am-portfolio",
  "private": true,
  "scripts": {
    "build": "npm run build:vendor && npm run build:css && npm run check:assets",
    "build:vendor": "sh ./scripts/build-vendor.sh",
    "build:css": "BROWSERSLIST_IGNORE_OLD_DATA=true tailwindcss -i ./styles/tailwind.input.css -o ./assets/css/tailwind.min.css --content ./index.html,./index-dark.html --minify",
    "check:assets": "node ./scripts/check-assets.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "gsap": "3.12.2",
    "lenis": "1.1.2",
    "tailwindcss": "3.4.19"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
